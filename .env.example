# ---------------------------------------------------------------
# ShieldCampus environment. Copy to .env.local and fill in.
# Never commit .env.local. Never put a spending key or seed phrase here.
# ---------------------------------------------------------------

# Public site URL (used for auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
# Either the legacy "anon" key or the new "publishable" key (sb_publishable_...) works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Either the legacy "service_role" key or the new "secret" key (sb_secret_...). SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Zcash network the app expects addresses for: mainnet or testnet
ZCASH_NETWORK=mainnet

# Rewards
REWARD_ZEC=0.01
DAILY_REWARD_CAP=50

# Rates (CoinGecko is used first; these are used if it is unreachable)
FALLBACK_ZEC_USD=40
FALLBACK_ZEC_NGN=60000

# Sponsor audit page PIN (/impact/audit). Use at least 6 digits.
AUDIT_PIN=

# AI tutor and Pidgin translation: any OpenAI-compatible chat completions API.
# Groq (default below) blocks some countries, including Nigeria. From Nigeria, use Google Gemini (free key at
# https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-flash-lite-latest
#   LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# Or OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Pick a fast model: "thinking" models are too slow for a live chat.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Optional: used automatically if the main model is overloaded (e.g. gemini-3.1-flash-lite).
LLM_FALLBACK_MODEL=

# Optional Level 2 worker only (worker/). Unified FULL VIEWING KEY (uview1...).
# View-only: it cannot spend funds. Never put a spending key here.
REWARD_FUND_UFVK=
REWARD_FUND_BIRTHDAY_HEIGHT=
