# ---------------------------------------------------------------
# ShieldCampus environment. Copy to .env.local and fill in.
# Never commit .env.local. Never put a spending key or seed phrase here.
# ---------------------------------------------------------------

# Public site URL (used for auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
# Either the legacy "anon" key or the new "publishable" key (sb_publishable_...) works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Either the legacy "service_role" key or the new "secret" key (sb_secret_...). SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Zcash network
# ---------------------------------------------------------------
# testnet (default, for development and the demo: TAZ coins, utest1 addresses, no real value)
# or mainnet (real ZEC, u1 addresses). Changing it needs a dev-server restart / Vercel redeploy.
# Switching networks also means every saved address must be re-entered for the new network.
ZCASH_NETWORK=testnet

# Zcash node JSON-RPC endpoint (optional). Powers the "Connected to Zcash testnet · block #N" indicator.
# Use a JSON-RPC (Zebra-compatible) endpoint from your provider (e.g. Tatum, QuickNode) or a local Zebra.
# NOT a lightwalletd/gRPC endpoint: those don't speak JSON-RPC. Copy the exact URL from your provider.
# Privacy note: a hosted provider can see your server's IP address and which calls it makes.
ZCASH_RPC_URL=
# API key, if your provider uses one. It is sent in the header below (check your provider's docs).
ZCASH_RPC_API_KEY=
ZCASH_RPC_API_KEY_HEADER=x-api-key
# Only for a local Zebra/zcashd with RPC auth enabled.
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
# Per-call timeout in milliseconds.
ZCASH_RPC_TIMEOUT_MS=6000

# Payment verification: manual (Level 1, always works: a person records the txid)
# or zallet (Level 2: also asks your own Zallet wallet to match memo + amount automatically).
# If Zallet is unreachable, ShieldCampus falls back to manual automatically.
PAYMENT_VERIFIER=manual
# Zallet wallet JSON-RPC (only for PAYMENT_VERIFIER=zallet). Run it yourself; import VIEWING keys only.
ZALLET_RPC_URL=
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=

# Reward fund: its public shielded address (must match ZCASH_NETWORK) and its VIEW-ONLY key
# (uviewtest1... on testnet, uview1... on mainnet). Server-side only, never sent to browsers.
# NEVER put a spending key or seed phrase here: the app refuses to start if it sees one.
REWARD_FUND_ADDRESS=
REWARD_FUND_VIEWING_KEY=

# Rewards
REWARD_ZEC=0.01
DAILY_REWARD_CAP=50

# Rates: CoinGecko is used first; these are used only if it is unreachable.
# On testnet the same ZEC price is used, labelled "demo value", so the flow looks identical to mainnet.
# Keep them close to the real price (checked 2026-11-14: 1 ZEC ≈ $908 ≈ ₦1,220,000).
FALLBACK_ZEC_USD=900
FALLBACK_ZEC_NGN=1220000

# Sponsor audit page PIN (/impact/audit). Use at least 6 digits.
AUDIT_PIN=

# AI tutor and Pidgin translation: any OpenAI-compatible chat completions API.
# Groq (default below) blocks some countries, including Nigeria. From Nigeria, use Google Gemini (free key at
# https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-flash-lite-latest
#   LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# Or OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Pick a fast model: "thinking" models are too slow for a live chat.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Optional: used automatically if the main model is overloaded (e.g. gemini-3.1-flash-lite).
LLM_FALLBACK_MODEL=
